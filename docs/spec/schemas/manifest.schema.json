{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcommander.dev/acap/1.0/manifest.schema.json",
  "title": "ACAP registry adapter manifest (adapter.json)",
  "description": "One per registry/<kind>/ directory. MUST be consistent with the accompanying acap-verify.json report.",
  "type": "object",
  "required": [
    "v", "kind", "displayName", "description", "acap", "level",
    "capabilities", "provides", "statusSource", "platforms",
    "repo", "license", "maintainers", "verifiedWith"
  ],
  "properties": {
    "v": { "const": 1 },
    "kind": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "acap": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["prompt", "answer", "interrupt", "mode"] }
    },
    "provides": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "statusSource": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["hook", "log-tail", "file-tail", "native-stream", "rpc", "sdk"]
      }
    },
    "injectVia": { "type": "array", "items": { "type": "string" } },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["macos", "linux", "windows"] }
    },
    "repo": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "contact"],
        "properties": {
          "name": { "type": "string" },
          "github": { "type": "string" },
          "contact": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "verifiedWith": { "type": "string" },
    "icon": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "not": { "properties": { "level": { "const": "L0" } } } },
      "then": { "required": ["injectVia"] }
    }
  ],
  "additionalProperties": true
}
